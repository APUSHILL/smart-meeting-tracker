spring.application.name=meeting-tracker

# MySQL Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/meeting_tracker_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Server
server.port=8080

# CORS (allow Angular dev server)
spring.web.cors.allowed-origins=http://localhost:4200

# Gemini AI
gemini.api.key=YOUR_GEMINI_API_KEY

# JWT
jwt.secret=YOUR_64_CHAR_SECRET_KEY_HERE
jwt.expiration=86400000
